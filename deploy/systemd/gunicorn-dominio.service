# /etc/systemd/system/gunicorn-dominio.service
#
# After uploading:
#   sudo systemctl daemon-reload
#   sudo systemctl enable gunicorn-dominio
#   sudo systemctl start gunicorn-dominio
#
# Status:    sudo systemctl status gunicorn-dominio
# Logs:      sudo journalctl -u gunicorn-dominio -f
# Restart:   sudo systemctl restart gunicorn-dominio

[Unit]
Description=Gunicorn for DOMINIO landing
After=network.target

[Service]
Type=notify
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/dominio
EnvironmentFile=/var/www/dominio/.env
RuntimeDirectory=gunicorn-dominio
RuntimeDirectoryMode=0755
# Tuned for a 512MB-1GB instance:
#   --workers 2          fits low-RAM boxes (raise to 3 only with >=2GB RAM)
#   --worker-class gthread --threads 4
#                        Every chat turn waits 10-20s on Anthropic while doing
#                        nothing. With sync workers that wait held a whole
#                        process, so TWO simultaneous conversations blocked the
#                        entire site. Threads release the GIL during network
#                        I/O and cost a few MB each, not a process: 2x4 = 8
#                        requests in flight for the RAM of 2.
#   --max-requests       recycle workers periodically to release leaked memory
#   --timeout 60         kill a worker stuck >60s (was the default 30s)
ExecStart=/var/www/dominio/venv/bin/gunicorn \
    --workers 2 \
    --worker-class gthread \
    --threads 4 \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --timeout 60 \
    --bind unix:/run/gunicorn-dominio/gunicorn.sock \
    --access-logfile - \
    --error-logfile - \
    dominio_website.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
