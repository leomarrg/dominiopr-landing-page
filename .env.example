# ============================================================
# DOMINIO — Environment variables
# Copy to .env (local) or set as systemd EnvironmentFile (server)
# NEVER commit .env to git
# ============================================================

# Generate a fresh key for production. Locally you can omit it (insecure dev key is used).
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-50-char-random-string

# False on production, True locally
DJANGO_DEBUG=False

# Comma-separated. Leading dot matches subdomains.
DJANGO_ALLOWED_HOSTS=.dominiopr.com,localhost,127.0.0.1

# Origins that can submit POST/PUT/DELETE forms
DJANGO_CSRF_TRUSTED_ORIGINS=https://dominiopr.com,https://www.dominiopr.com,https://*.dominiopr.com

# Public base URL used to build links in emails (e.g. the "View in dashboard"
# button on lead notifications). Only change if the site moves domains.
# DJANGO_SITE_URL=https://dominiopr.com

# SQLite path (default works in repo root)
# DJANGO_DB_PATH=/var/www/dominio/db.sqlite3

# HSTS — start at 3600 (1 hour). After confirming SSL works for all subdomains
# bump to 31536000 (1 year) and consider enabling HSTS preload.
DJANGO_HSTS_SECONDS=3600
# Password-reset links expire after this many seconds (default 1 hour).
DJANGO_PASSWORD_RESET_TIMEOUT=3600

# Log level for django logger
DJANGO_LOG_LEVEL=INFO

# ============================================================
# EMAIL — transactional mail (lead alerts, onboarding, bookings, reminders)
# Default provider: Resend SMTP (free: 3,000/month, 100/day).
# The From domain must be verified at https://resend.com/domains first.
# Step by step (DNS records, API key, test): docs/lanzamiento/02-correo.md
# ============================================================
DJANGO_EMAIL_HOST=smtp.resend.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
# Username is literally the word "resend"; password is the API key (re_...)
DJANGO_EMAIL_HOST_USER=resend
DJANGO_EMAIL_HOST_PASSWORD=re_your-resend-api-key
# Must be an address on the verified domain. Quotes are fine here (systemd and
# python-dotenv both strip them); the display name is what people see.
DJANGO_DEFAULT_FROM_EMAIL="DOMINIO <hola@dominiopr.com>"
# Where new leads and ops alerts are emailed (also used as Reply-To)
DJANGO_CONTACT_NOTIFY_EMAIL=leomar@dominiopr.com
# Seconds to wait for the SMTP server before giving up, so a provider outage
# cannot hang a request. Default 10.
DJANGO_EMAIL_TIMEOUT=10

# --- Alternative: Gmail SMTP with an App Password (previous setup) ---
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=creatudominiopr@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-16-char-app-password-no-spaces
# DJANGO_DEFAULT_FROM_EMAIL=creatudominiopr@gmail.com
# DJANGO_CONTACT_NOTIFY_EMAIL=creatudominiopr@gmail.com

# ============================================================
# ANALYTICS — Google Analytics 4
# Get this from analytics.google.com (Admin > Data Streams > Web).
# Leave empty to disable analytics entirely.
# ============================================================
GA_MEASUREMENT_ID=

# ============================================================
# AI AGENT — the "Ask DOMINIO" website chat assistant
# Get a key at https://console.anthropic.com (Settings > API Keys).
# Empty key = the chat widget is hidden. Inference runs on Anthropic's
# cloud, so it does NOT load this server.
# ============================================================
ANTHROPIC_API_KEY=
# Optional: override the model (default is fast + cheap Haiku).
# DOMINIO_AGENT_MODEL=claude-haiku-4-5
# Optional: max conversation turns sent back per request (cost guard).
# DOMINIO_AGENT_MAX_TURNS=12

# ============================================================
# PHASE 2 — payments, notifications, provider (all optional:
# unset = graceful degradation, nothing breaks)
# ============================================================

# M-01 Stripe: hosted Checkout + Billing. Without keys the signup keeps the
# email-coordination flow. Prices are created in the Stripe dashboard;
# step by step (products, webhook, portal, test -> live): docs/lanzamiento/01-stripe.md
# Test mode and live mode have DIFFERENT keys, webhook secrets and price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
# One-time "Instalacion y configuracion" price per plan, charged in the same
# Checkout as the first period (Starter $500, Pro $1,000, Scale $2,500).
# Leave a plan empty = no setup fee for that plan.
STRIPE_PRICE_STARTER_SETUP=
STRIPE_PRICE_PRO_SETUP=
STRIPE_PRICE_SCALE_SETUP=
# Sales tax (IVU). Prices are advertised WITHOUT tax, so Checkout adds this on
# top of every line item, subscription and setup fee alike. Create it with
# `manage.py stripe_bootstrap --tax-rate 4` (or whatever rate your accountant
# confirms) and paste the id here. Empty = no tax line is ever charged.
STRIPE_TAX_RATE_ID=

# M-06 Twilio: outbound WhatsApp/SMS alerts to tenants (email always stays on).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# M-11: to switch transactional email to another provider (Postmark, SES),
# just repoint these (already env-driven): DJANGO_EMAIL_HOST,
# DJANGO_EMAIL_HOST_USER, DJANGO_EMAIL_HOST_PASSWORD, DJANGO_DEFAULT_FROM_EMAIL.

# M-12: agent model provider (only 'anthropic' implemented today).
DOMINIO_AGENT_PROVIDER=anthropic

# M-03: blended cost knob for the reports page ($ per million tokens).
DOMINIO_COST_PER_MTOK=3.0

# --- Alertas de error (Django AdminEmailHandler) ---
# Quién recibe un correo cuando el sitio lanza un 500 o falla un aprovisionamiento.
# Formato: "Nombre:correo, Nombre2:correo2" o solo "correo".
# Si se deja vacío, se usa DJANGO_CONTACT_NOTIFY_EMAIL.
DJANGO_ADMINS=
# Remitente de esos correos de error (por defecto, DJANGO_DEFAULT_FROM_EMAIL).
DJANGO_SERVER_EMAIL=

# --- Topes del demo público (/api/demo/) ---
# Presupuesto propio, separado del de los clientes que pagan: sin esto, un
# visitante anónimo podía agotar la cuota y dejar sin agente a todos los tenants.
DOMINIO_DEMO_DAILY_CAP=150
DOMINIO_DEMO_IP_DAILY_CAP=20
