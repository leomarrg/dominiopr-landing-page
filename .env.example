# ============================================================
# DOMINIO — Environment variables
# Copy to .env (local) or set as systemd EnvironmentFile (server)
# NEVER commit .env to git
# ============================================================

# Generate a fresh key for production. Locally you can omit it (insecure dev key is used).
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-50-char-random-string

# False on production, True locally
DJANGO_DEBUG=False

# Comma-separated. Leading dot matches subdomains.
DJANGO_ALLOWED_HOSTS=.dominiopr.com,localhost,127.0.0.1

# Origins that can submit POST/PUT/DELETE forms
DJANGO_CSRF_TRUSTED_ORIGINS=https://dominiopr.com,https://www.dominiopr.com,https://*.dominiopr.com

# Public base URL used to build links in emails (e.g. the "View in dashboard"
# button on lead notifications). Only change if the site moves domains.
# DJANGO_SITE_URL=https://dominiopr.com

# SQLite path (default works in repo root)
# DJANGO_DB_PATH=/var/www/dominio/db.sqlite3

# HSTS — start at 3600 (1 hour). After confirming SSL works for all subdomains
# bump to 31536000 (1 year) and consider enabling HSTS preload.
DJANGO_HSTS_SECONDS=3600
# Password-reset links expire after this many seconds (default 1 hour).
DJANGO_PASSWORD_RESET_TIMEOUT=3600

# Log level for django logger
DJANGO_LOG_LEVEL=INFO

# ============================================================
# EMAIL — transactional mail (lead alerts, onboarding, bookings, reminders)
# Default provider: Resend SMTP (free: 3,000/month, 100/day).
# The From domain must be verified at https://resend.com/domains first.
# Step by step (DNS records, API key, test): docs/lanzamiento/02-correo.md
# ============================================================
DJANGO_EMAIL_HOST=smtp.resend.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
# Username is literally the word "resend"; password is the API key (re_...)
DJANGO_EMAIL_HOST_USER=resend
DJANGO_EMAIL_HOST_PASSWORD=re_your-resend-api-key
# Must be an address on the verified domain. Quotes are fine here (systemd and
# python-dotenv both strip them); the display name is what people see.
DJANGO_DEFAULT_FROM_EMAIL="DOMINIO <hola@dominiopr.com>"
# Where new leads and ops alerts are emailed (also used as Reply-To)
DJANGO_CONTACT_NOTIFY_EMAIL=leomar@dominiopr.com
# Seconds to wait for the SMTP server before giving up, so a provider outage
# cannot hang a request. Default 10.
DJANGO_EMAIL_TIMEOUT=10
# Lead/booking email check: besides the syntax and the disposable-domain list,
# ask DNS (Cloudflare DNS-over-HTTPS, 3 s timeout, cached 24 h per domain)
# whether the email's domain exists and accepts mail. Fail-open: if the lookup
# is slow or fails the email is accepted. Always off under `manage.py test`.
# DOMINIO_EMAIL_DNS_CHECK=True

# --- Verificacion humana (hCaptcha) ---
# Chat de los widgets, demo de /get-started/, formularios publicos, login del
# dashboard, reset de contrasena y login del admin. Con las DOS llaves vacias
# todo queda APAGADO y el sitio funciona igual que antes. Llaves en
# https://dashboard.hcaptcha.com. Llaves de prueba (siempre pasan, solo dev):
#   HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
#   HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
# Pase humano del chat: segundos de validez y mensajes maximos por pase.
# HUMAN_PASS_TTL=7200
# HUMAN_PASS_MAX_MESSAGES=30

# --- Alternative: Gmail SMTP with an App Password (previous setup) ---
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=creatudominiopr@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-16-char-app-password-no-spaces
# DJANGO_DEFAULT_FROM_EMAIL=creatudominiopr@gmail.com
# DJANGO_CONTACT_NOTIFY_EMAIL=creatudominiopr@gmail.com

# ============================================================
# ANALYTICS — Google Analytics 4
# Get this from analytics.google.com (Admin > Data Streams > Web).
# Leave empty to disable analytics entirely.
# ============================================================
GA_MEASUREMENT_ID=

# ============================================================
# AI AGENT — the "Ask DOMINIO" website chat assistant
# Get a key at https://console.anthropic.com (Settings > API Keys).
# Empty key = the chat widget is hidden. Inference runs on Anthropic's
# cloud, so it does NOT load this server.
# ============================================================
ANTHROPIC_API_KEY=
# Optional: override the model (default is fast + cheap Haiku).
# DOMINIO_AGENT_MODEL=claude-haiku-5-5
# DOMINIO_AGENT_EFFORT=low          # low | medium | high | auto (auto = low siempre; medium solo ante intentos de manipulación)
# DOMINIO_AGENT_MAX_TOKENS=1500
# Optional: max conversation turns sent back per request (cost guard).
# DOMINIO_AGENT_MAX_TURNS=12
# Tope GLOBAL de llamadas al agente por dia (todos los tenants + demo). Es el
# freno de gasto: pasado el tope el chat contesta 'vuelve manana' en vez de
# seguir cobrando tokens.
# DOMINIO_AGENT_DAILY_CAP=2000
# Conversaciones nuevas que una misma IP puede abrir por cliente y dia (0 = sin tope).
# DOMINIO_NEW_CONVERSATIONS_PER_IP_DAY=15
# Minimo para que el chatbot funcione en produccion: ANTHROPIC_API_KEY +
# el bloque EMAIL de arriba (sin SMTP no llegan los leads que captura).

# ============================================================
# PHASE 2 — payments, notifications, provider (all optional:
# unset = graceful degradation, nothing breaks)
# ============================================================

# M-01 Stripe: hosted Checkout + Billing. Without keys the signup keeps the
# email-coordination flow. Prices are created in the Stripe dashboard;
# step by step (products, webhook, portal, test -> live): docs/lanzamiento/01-stripe.md
# Test mode and live mode have DIFFERENT keys, webhook secrets and price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
# One-time "Instalacion y configuracion" price per plan, charged in the same
# Checkout as the first period (Starter $500, Pro $1,000, Scale $2,500).
# Leave a plan empty = no setup fee for that plan.
STRIPE_PRICE_STARTER_SETUP=
STRIPE_PRICE_PRO_SETUP=
STRIPE_PRICE_SCALE_SETUP=
# Sales tax (IVU). Prices are advertised WITHOUT tax, so Checkout adds this on
# top of every line item, subscription and setup fee alike. Create it with
# `manage.py stripe_bootstrap --tax-rate 4` (or whatever rate your accountant
# confirms) and paste the id here. Empty = no tax line is ever charged.
STRIPE_TAX_RATE_ID=

# M-06 Twilio: outbound SMS alerts to tenants and phone-only booking texts
# (email always stays on). Twilio es SOLO SMS: el canal de WhatsApp va por la
# Cloud API de Meta (seccion Fase G). Un cliente con notify_channel=whatsapp
# recibe el mismo aviso por SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=

# --- Fase G: WhatsApp de los visitantes por la Cloud API de Meta (sin Twilio) ---
# Paso a paso en DEPLOYMENT.md, seccion "WhatsApp (Cloud API de Meta)". Todo
# vacio = el webhook responde 503 y no se envia nada. Una sola app de Meta y
# un System User de DOMINIO para todos los clientes; por cliente solo se crea
# un ChannelAccount en el admin con el phone_number_id de su numero.
# Token permanente del System User (permisos whatsapp_business_messaging y
# whatsapp_business_management).
META_WA_ACCESS_TOKEN=
# App Secret de la app (Configuracion > Basica). Firma cada POST del webhook.
META_APP_SECRET=
# Cadena inventada que se pega en la configuracion del webhook; Meta la
# devuelve en la verificacion (GET).
META_WA_VERIFY_TOKEN=
# Version del Graph API fijada para los envios.
# META_GRAPH_VERSION=v23.0
# Plantillas de UTILIDAD aprobadas para avisos fuera de la ventana de 24 h
# (recordatorio y cambio de estado de citas). Vacias = SMS por Twilio o nada.
#   recordatorio: {{1}} negocio, {{2}} fecha/hora, {{3}} local
#   estado:       {{1}} negocio, {{2}} fecha/hora, {{3}} local, {{4}} estado
# META_WA_TEMPLATE_REMINDER=cita_recordatorio
# META_WA_TEMPLATE_STATUS=cita_estado
# Clave del hash que sustituye al numero del visitante en conversaciones y
# bajas (STOP). Generala una vez (igual que DJANGO_SECRET_KEY) y NO la rotes:
# cada contacto perderia su historial y su baja. Vacia = usa SECRET_KEY.
DOMINIO_PHONE_HASH_KEY=
# Mensajes por contacto y dia antes de que el agente deje de responder.
# DOMINIO_WA_CONTACT_DAILY_CAP=40

# M-11: to switch transactional email to another provider (Postmark, SES),
# just repoint these (already env-driven): DJANGO_EMAIL_HOST,
# DJANGO_EMAIL_HOST_USER, DJANGO_EMAIL_HOST_PASSWORD, DJANGO_DEFAULT_FROM_EMAIL.

# M-12: agent model provider (only 'anthropic' implemented today).
DOMINIO_AGENT_PROVIDER=anthropic

# M-03: blended cost knob for the reports page ($ per million tokens).
# Solo se usa como respaldo si el modelo no esta en DOMINIO_MODEL_PRICES (settings.py).
# DOMINIO_COST_PER_MTOK=0.10

# Backend de correo. En produccion se deja vacio (SMTP). Solo para probar en
# local sin enviar nada: django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=

# --- Alertas de error (Django AdminEmailHandler) ---
# Quién recibe un correo cuando el sitio lanza un 500 o falla un aprovisionamiento.
# Formato: "Nombre:correo, Nombre2:correo2" o solo "correo".
# Si se deja vacío, se usa DJANGO_CONTACT_NOTIFY_EMAIL.
DJANGO_ADMINS=
# Remitente de esos correos de error (por defecto, DJANGO_DEFAULT_FROM_EMAIL).
DJANGO_SERVER_EMAIL=

# --- Topes del demo público (/api/demo/) ---
# Presupuesto propio, separado del de los clientes que pagan: sin esto, un
# visitante anónimo podía agotar la cuota y dejar sin agente a todos los tenants.
DOMINIO_DEMO_DAILY_CAP=150
DOMINIO_DEMO_IP_DAILY_CAP=20
# Tope por tenant y por dia de leads / citas / escalaciones creadas desde el
# chat. El token del widget es publico por diseno; esto es lo que frena a un
# bot que quiera llenar el CRM y el celular de un cliente de basura.
DOMINIO_TENANT_ACTION_DAILY_CAP=40

# --- Fase 8 / Fase I: conocimiento desde el sitio web y archivos subidos ---
# Solo lo usa el staff de DOMINIO (los clientes no entrenan su agente). Lo
# procesa el cron `process_knowledge` (cada minuto, `timeout 3600`), nunca el
# request web. Paginas maximas por escaneo, segundos maximos de rastreo por
# escaneo y tamano maximo del archivo subido (MB). Si subes el tamano, sube
# tambien client_max_body_size en la location /dashboard/knowledge/upload/ de
# nginx (hoy 51m) y revisa el timeout del cron.
# DOMINIO_INGEST_MAX_PAGES=500
# DOMINIO_INGEST_TIME_BUDGET=1200
# DOMINIO_INGEST_UPLOAD_MAX_MB=50
# Texto maximo (caracteres) de un escaneo o archivo que se manda a la IA; es el
# tope de costo de una ingesta (~4 caracteres por token). El codigo lo limita a
# 8,000,000 aunque pongas mas.
# DOMINIO_INGEST_MAX_INPUT_CHARS=4000000
# Modelo y effort para escanear/destilar (NO el chat, que sigue con
# DOMINIO_AGENT_MODEL). Sonnet medium: se hace pocas veces y la calidad de la
# extraccion importa. Effort valido: low, medium, high, xhigh, max; otro valor
# cae a medium.
# DOMINIO_INGEST_MODEL=claude-sonnet-5-5
# DOMINIO_INGEST_EFFORT=medium
# Techo tecnico del conocimiento ACTIVO de un cliente (todas las fuentes).
# Publicar por encima se rechaza; los 8,000/40,000 de la pagina son solo aviso.
# DOMINIO_KNOWLEDGE_HARD_MAX_CHARS=160000   (tope: 400000)

# --- M-20 Redes sociales (Instagram / Facebook / TikTok) ---
# Publicacion programada desde el admin. Sin credenciales, `publish_due` no
# publica nada y lo dice: nunca publica a medias.
# Version del Graph API de Meta (subela cuando Meta deprecie la actual).
SOCIAL_GRAPH_VERSION=v21.0
# Token de pagina de larga duracion (sirve para Facebook Y para la cuenta de
# Instagram Business enlazada a esa pagina).
SOCIAL_META_ACCESS_TOKEN=
# Id de la cuenta de Instagram Business (no el @usuario).
SOCIAL_IG_USER_ID=
# Id de la pagina de Facebook.
SOCIAL_FB_PAGE_ID=
# TikTok Content Posting API.
SOCIAL_TIKTOK_ACCESS_TOKEN=
# Si la app de TikTok todavia NO paso la auditoria de content posting, el unico
# valor que TikTok acepta es SELF_ONLY; con cualquier otro rechaza el post.
SOCIAL_TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Reintentos antes de marcar el post como fallido, y tope del backoff.
SOCIAL_MAX_ATTEMPTS=8
SOCIAL_BACKOFF_CAP_SECONDS=1800
