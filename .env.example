# ============================================================
# DOMINIO — Environment variables
# Copy to .env (local) or set as systemd EnvironmentFile (server)
# NEVER commit .env to git
# ============================================================

# Generate a fresh key for production. Locally you can omit it (insecure dev key is used).
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-50-char-random-string

# False on production, True locally
DJANGO_DEBUG=False

# Comma-separated. Leading dot matches subdomains.
DJANGO_ALLOWED_HOSTS=.dominiopr.com,localhost,127.0.0.1

# Origins that can submit POST/PUT/DELETE forms
DJANGO_CSRF_TRUSTED_ORIGINS=https://dominiopr.com,https://www.dominiopr.com,https://*.dominiopr.com

# Public base URL used to build links in emails (e.g. the "View in dashboard"
# button on lead notifications). Only change if the site moves domains.
# DJANGO_SITE_URL=https://dominiopr.com

# SQLite path (default works in repo root)
# DJANGO_DB_PATH=/var/www/dominio/db.sqlite3

# HSTS — start at 3600 (1 hour). After confirming SSL works for all subdomains
# bump to 31536000 (1 year) and consider enabling HSTS preload.
DJANGO_HSTS_SECONDS=3600

# Log level for django logger
DJANGO_LOG_LEVEL=INFO

# ============================================================
# EMAIL — contact form notifications (Gmail SMTP + App Password)
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
# ============================================================
DJANGO_EMAIL_HOST_USER=creatudominiopr@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-16-char-app-password-no-spaces
DJANGO_DEFAULT_FROM_EMAIL=creatudominiopr@gmail.com
# Where new leads are emailed (defaults to creatudominiopr@gmail.com)
DJANGO_CONTACT_NOTIFY_EMAIL=creatudominiopr@gmail.com

# ============================================================
# ANALYTICS — Google Analytics 4
# Get this from analytics.google.com (Admin > Data Streams > Web).
# Leave empty to disable analytics entirely.
# ============================================================
GA_MEASUREMENT_ID=

# ============================================================
# AI AGENT — the "Ask DOMINIO" website chat assistant
# Get a key at https://console.anthropic.com (Settings > API Keys).
# Empty key = the chat widget is hidden. Inference runs on Anthropic's
# cloud, so it does NOT load this server.
# ============================================================
ANTHROPIC_API_KEY=
# Optional: override the model (default is fast + cheap Haiku).
# DOMINIO_AGENT_MODEL=claude-haiku-4-5
# Optional: max conversation turns sent back per request (cost guard).
# DOMINIO_AGENT_MAX_TURNS=12
